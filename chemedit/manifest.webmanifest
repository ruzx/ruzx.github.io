{
  "name": "ChemEdit — structures & lab notebook",
  "short_name": "ChemEdit",
  "description": "A free educational tool: draw chemical structures, practise keeping a lab notebook. Works offline; files stay on your device.",
  "id": "./",
  "start_url": "./#/library",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f6f7f9",
  "theme_color": "#2f64d8",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Structures", "url": "./#/library", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lab notebook", "url": "./#/eln", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    {
      "action": "./#/library",
      "accept": {
        "chemical/x-mdl-molfile": [".mol", ".mdl"],
        "chemical/x-mdl-sdfile": [".sdf", ".sd"],
        "chemical/x-mdl-rxnfile": [".rxn"],
        "chemical/x-cdxml": [".cdxml"],
        "application/x-chemedit": [".chemedit", ".ket"],
        "chemical/x-daylight-smiles": [".smi", ".smiles"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
